# From your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Where the map opens (latitude,longitude): replace with your campus. Zoom 17 shows a few buildings.
NEXT_PUBLIC_MAP_CENTER=30.0277,31.2101
NEXT_PUBLIC_MAP_ZOOM=17

# Optional: only allow sign-in with this email domain, e.g. eng.cu.edu.eg. Leave empty to allow any email.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=
